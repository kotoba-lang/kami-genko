{
  // Static host for the standalone genko editor at genko.gftd.ai.
  //
  // Assets-only: no `main`, because there is nothing for a Worker to do. The
  // page is a build artifact (scripts/gen-page.cljs -> public/index.html) and
  // the editor is a cljs bundle; every document lives in the browser's
  // localStorage, or in kotobase.net when the user presses ☁ save with a key.
  // No D1, no R2, no secrets — nothing to leak and nothing to run.
  //
  // Deploy from the repo root (assets.directory is relative to this file):
  //   npx shadow-cljs release app
  //   npm run page
  //   npx wrangler deploy -c deploy/wrangler.jsonc
  "name": "genko-gftd",
  "compatibility_date": "2025-03-17",
  "assets": {
    "directory": "../public"
  },
  "routes": [
    { "pattern": "genko.gftd.ai/*", "zone_name": "gftd.ai" }
  ]
}
