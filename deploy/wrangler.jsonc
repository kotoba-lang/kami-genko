{
  // KAMI genko at itonami.cloud/genko.
  //
  // A PATH route, not a host: cloud-itonami's apex worker answers
  // `itonami.cloud/*`, and Cloudflare resolves the more specific path route
  // first, so this takes /genko* and the cockpit keeps everything else.
  //
  // Assets-only — no `main`. The page is a build artifact and the editor is a
  // cljs bundle; documents live in localStorage, or in kotobase.net behind the
  // user's own key. No D1, no R2, no secrets.
  //
  // Deploy:
  //   npx shadow-cljs release app && npm run page
  //   npx wrangler deploy -c deploy/wrangler.jsonc
  "name": "itonami-genko",
  "compatibility_date": "2025-03-17",
  "assets": { "directory": "../public" },
  "routes": [{ "pattern": "itonami.cloud/genko*", "zone_name": "itonami.cloud" }]
}
